# Beispieldatei, secret-frei. Echte Werte niemals hier oder in Git ablegen
# (siehe docs/development-workflow.md, Abschnitt 5).
POSTGRES_PASSWORD=changeme

# Produktklasse dieses Geräts, serverseitig bei Provisioning gesetzt.
# Niemals vom Client änderbar (siehe docs/architecture/product-classes.md).
# Werte: pi | mini | server | rack
SYSTEMONE_PRODUCT_CLASS=pi
