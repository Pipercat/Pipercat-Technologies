# Beispieldatei, secret-frei. Echte Werte niemals hier oder in Git ablegen
# (siehe docs/development-workflow.md, Abschnitt 5).
POSTGRES_PASSWORD=changeme

# Produktklasse dieses Geräts, serverseitig bei Provisioning gesetzt.
# Niemals vom Client änderbar (siehe docs/architecture/product-classes.md).
# Werte: pi | mini | server | rack
SYSTEMONE_PRODUCT_CLASS=pi

# Fernet-Schlüssel für die verschlüsselte Integrations-Secret-Ablage
# (siehe docs/architecture/secrets-management.md, S1V2-02-013). Pro
# Kundensystem einmalig generieren, z. B.:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Niemals dieser Beispielwert in Produktion verwenden.
SECRETS_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key
