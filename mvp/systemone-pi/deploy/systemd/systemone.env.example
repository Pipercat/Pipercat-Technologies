# Copy to /etc/systemone-pi/systemone.env with owner root:root and mode 0600.
PORT=4171
HUE_MODE=simulation
CAMERA_MODULE_ENABLED=false
CAMERA_MODE=simulation
PIHOLE_MODULE_ENABLED=false
PIHOLE_MODE=simulation
YOUDO_CALENDAR_ENABLED=false
YOUDO_TASKS_ENABLED=false
BACKUP_INTERVAL_MS=86400000

# Set only after local provisioning and validation.
# TLS_KEY_PATH=/var/lib/systemone-pi/tls/systemone-device.key
# TLS_CERT_PATH=/var/lib/systemone-pi/tls/systemone-device.crt
# UPDATE_PUBLIC_KEY_PATH=/etc/systemone-pi/update-public.pem
# SYSTEMONE_EXPORT_ROOTS=/media/systemone-backup

# Secrets must never be committed. Keep the EnvironmentFile at mode 0600.
# PIHOLE_API_TOKEN=

# Boolean values must be exactly true or false; modes exactly simulation or real.
# Partial TLS configuration or missing key files block startup instead of falling back to HTTP.
